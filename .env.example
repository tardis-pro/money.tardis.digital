STORE_BACKEND=json
DATABASE_URL=postgres://postgres:postgres@localhost:5432/policy_signal
ARTIFACTS_DIR=./data/artifacts

# Screeni-py integration
SCREENIPY_PYTHON=python3
SCREENIPY_SCRIPT_PATH=src/screenipy.py

# Training pipeline
MODEL_TRAIN_PYTHON=python3
MODEL_TRAIN_SCRIPT=./scripts/train_model.py
MODELS_DIR=./data/models

# Telegram Bot for QVM-Hybrid alerts
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram chat ID (use @userinfobot to find your ID)
TELEGRAM_CHAT_ID=
# Webhook URL for Telegram (if using webhook mode)
TELEGRAM_WEBHOOK_URL=

# MiniMax AI — Mirror Analyst for signal classification
# Get API key from https://platform.minimax.io/
MINIMAX_API_KEY=
MINIMAX_MODEL=minimax/Minimax-m2.5
