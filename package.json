{
  "name": "india-policy-signal-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite --port 5173 --host",
    "dev:server": "tsx src/server.ts",
    "migrate": "tsx scripts/migrate.mjs",
    "data:load": "node scripts/full-load.mjs",
    "screenipy:run": "python3 src/screenipy.py 1 0 --output data/screenipy-latest.csv",
    "build": "tsc -p tsconfig.json && vite build && vite build --ssr src/server-entry.tsx --outDir dist/server",
    "build:client": "vite build --outDir dist/client --manifest",
    "build:server": "vite build --ssr src/server-entry.tsx --outDir dist/server",
    "start": "NODE_ENV=production node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "e2e:backfill": "node scripts/e2e_backfill.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "framer-motion": "^12.33.0",
    "htm": "^3.1.1",
    "pg": "^8.13.1",
    "recharts": "^3.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.1"
  }
}
